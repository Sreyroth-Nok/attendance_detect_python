# Optional frontend settings. Copy to frontend/.env.local if you need to change them.

# Where the Vite dev server forwards /api requests (development only).
VITE_PROXY_TARGET=http://localhost:8000

# Set only when the frontend is served separately from the API in production,
# e.g. https://api.example.edu  (leave empty to call /api on the same origin).
VITE_API_BASE_URL=
