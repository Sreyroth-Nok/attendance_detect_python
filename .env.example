# Copy this file to `.env` (project root) and fill in real values.
# NEVER commit the real .env file.

# development | test | production
ENVIRONMENT=development

# SQLAlchemy URL for PostgreSQL. URL-encode special characters in the password
# (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/attendance_db

# Used only by the automated tests. The database name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/attendance_test_db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin key required (header X-API-Key) for add/edit/deactivate/import/export.
# Leave empty ONLY for local development. Required when ENVIRONMENT=production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Attendance sheet scanning.
#   offline (default): free, runs on this computer (OCR + ink colour), no key needed
#   claude: Claude vision via the Anthropic API - needs ANTHROPIC_API_KEY (paid,
#           key from https://platform.claude.com -> API keys); photos are sent to Anthropic
SHEET_READER=offline
ANTHROPIC_API_KEY=
ATTENDANCE_SCAN_MODEL=claude-opus-5-5

# Khmer names for the offline reader (Tesseract + khm.traineddata). Leave empty to auto-detect
# C:\Program Files\Tesseract-OCR and %LOCALAPPDATA%\tessdata.
TESSERACT_CMD=
TESSDATA_DIR=
MAX_SCAN_BYTES=10485760

# CSV import limits
MAX_IMPORT_BYTES=2097152
MAX_IMPORT_ROWS=5000
